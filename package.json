{
  "name": "code-ide",
  "private": true,
  "version": "0.2.0",
  "description": "IDE desktop con assistente AI agentico locale (Ollama/LM Studio/OmniRoute/OpenRouter), editor Monaco, terminale integrato e skill personalizzabili.",
  "author": "Giuseppe Lobbene",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "postinstall": "node scripts/fix-node-pty-permissions.js",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.codeide.app",
    "productName": "Code-IDE",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "src/skills/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**/*",
      "**/node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "mammoth": "^1.12.2",
    "node-pty": "^1.1.0",
    "node-telegram-bot-api": "^2.1.0",
    "onnxruntime-node": "^1.29.0",
    "patchright": "^1.62.3",
    "pdf-parse": "^2.4.5",
    "ppu-doclayout": "^1.0.0",
    "ppu-paddle-ocr": "^6.4.3",
    "prettier": "^3.9.6",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.0"
  }
}
